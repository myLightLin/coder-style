.gallery-card {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 24rpx;
}

.gallery-card__hero,
.gallery-card__thumb,
.piece-card__thumb {
  overflow: hidden;
}

.gallery-card__hero {
  min-height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.gallery-card__thumb-name,
.block__title,
.piece-card__name {
  display: block;
}

.gallery-card__hero-image,
.gallery-card__thumb-image,
.piece-card__thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-card__thumbs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.gallery-card__thumb {
  min-height: 202rpx;
  border-radius: 20rpx;
  position: relative;
}

.gallery-card__thumb-name {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.4;
  text-shadow: 0 2rpx 10rpx rgba(17, 24, 39, 0.38);
}

.block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block__title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.block__summary,
.block__item {
  color: var(--text-secondary);
}

.block__summary {
  display: block;
  line-height: 1.7;
}

.block__item {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.piece-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.piece-card {
  padding: 14rpx;
  border-radius: 20rpx;
  background: rgba(250, 248, 243, 0.96);
}

.piece-card__thumb {
  min-height: 112rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.piece-card__name {
  font-size: 22rpx;
  line-height: 1.5;
}

.bottom-cta {
  margin-top: 10rpx;
  margin-bottom: 24rpx;
}
