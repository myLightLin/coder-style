.tag-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(221, 229, 198, 0.72);
  color: #596550;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-chip--light {
  background: rgba(255, 255, 255, 0.86);
  color: var(--text-secondary);
  border: 2rpx solid rgba(111, 148, 184, 0.18);
}
