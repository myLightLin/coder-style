.gallery-card {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 24rpx;
}

.gallery-card__hero,
.gallery-card__thumb,
.piece-card__thumb {
  background:
    linear-gradient(180deg, rgba(17, 24, 39, 0.04), rgba(17, 24, 39, 0.18)),
    linear-gradient(135deg, #d9d4ca 0%, #f1ece3 48%, #b8c7d6 100%);
}

.gallery-card__hero {
  min-height: 420rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-end;
}

.gallery-card__label,
.gallery-card__thumb-name,
.block__title,
.piece-card__name {
  display: block;
}

.gallery-card__label {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.5;
}

.gallery-card__thumbs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.gallery-card__thumb {
  min-height: 202rpx;
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.gallery-card__thumb-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.gallery-card__thumb-name {
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1.4;
}

.block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.block__title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.block__summary,
.block__item {
  color: var(--text-secondary);
}

.block__summary {
  display: block;
  line-height: 1.7;
}

.block__item {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.piece-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.piece-card {
  padding: 14rpx;
  border-radius: 20rpx;
  background: rgba(250, 248, 243, 0.96);
}

.piece-card__thumb {
  min-height: 112rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.piece-card__name {
  font-size: 22rpx;
  line-height: 1.5;
}

.bottom-cta {
  margin-top: 10rpx;
  margin-bottom: 24rpx;
}
