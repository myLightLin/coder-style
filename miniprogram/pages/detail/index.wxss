.hero-card,
.block {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.hero-card__title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.hero-card__note,
.block__summary,
.piece-row__meta {
  color: var(--text-secondary);
}

.block__item {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.piece-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--divider);
}

.piece-row:last-child {
  border-bottom: 0;
}

.piece-row__name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
