.hero {
  padding: 8rpx 0 12rpx;
}

.hero__title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.summary-card__profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.summary-card__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #d9ccb7 0%, #aab7a1 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.summary-card__greeting,
.summary-card__hint,
.summary-card__temp,
.summary-card__meta,
.cold-start__title,
.cold-start__hint,
.featured-card__title {
  display: block;
}

.summary-card__greeting {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.summary-card__hint,
.summary-card__meta {
  color: var(--text-secondary);
  line-height: 1.6;
}

.summary-card__weather {
  min-width: 172rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 0 0 2rpx rgba(234, 230, 223, 0.9);
}

.summary-card__temp {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.hero__cta {
  margin: 0 0 20rpx;
}

.hero__subcta {
  margin-bottom: 20rpx;
}

.cold-start {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(127, 166, 201, 0.16);
}

.cold-start__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(127, 166, 201, 0.12);
  color: #6b93b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.cold-start__content {
  flex: 1;
}

.cold-start__title,
.featured-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.cold-start__arrow {
  font-size: 40rpx;
  color: var(--text-secondary);
}

.section-label {
  font-size: 38rpx;
  font-weight: 700;
  margin: 0 0 16rpx;
}

.quick-scenes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

.quick-scenes__item {
  min-width: 180rpx;
  text-align: center;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(17, 24, 39, 0.06);
}

.quick-scenes__item--active {
  background: rgba(232, 236, 218, 0.96);
  color: #425166;
}

.featured-card {
  display: grid;
  grid-template-columns: 1fr 240rpx;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.featured-card__copy {
  padding-top: 6rpx;
}

.featured-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  color: var(--text-secondary);
}

.featured-card__meta-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(232, 236, 218, 0.88);
}

.featured-card__visual {
  min-height: 252rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.featured-card__image {
  width: 100%;
  height: 100%;
  display: block;
}
