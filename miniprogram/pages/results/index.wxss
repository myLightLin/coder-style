.summary {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.summary__label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.summary__banner {
  display: block;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: var(--tag-bg);
  color: var(--text-primary);
  line-height: 1.5;
}

.summary__note {
  display: block;
  margin-top: 12rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
