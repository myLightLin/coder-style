@import "./styles/variables.wxss";

page {
  background: linear-gradient(180deg, #faf6ef 0%, #f5efe6 100%);
  color: var(--text-primary);
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
}

.page-shell {
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.glass-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 38rpx rgba(57, 78, 107, 0.08);
}

.primary-button {
  background: linear-gradient(135deg, #87a9c9 0%, #6f94b8 100%);
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 28rpx 24rpx;
  line-height: 1;
  box-shadow: 0 16rpx 32rpx rgba(111, 148, 184, 0.22);
}

.ghost-button {
  border: 2rpx solid rgba(111, 148, 184, 0.24);
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
}
